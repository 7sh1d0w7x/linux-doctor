{
  "name": "linux-doctor",
  "version": "0.7.3",
  "description": "Read-only health checks for your Linux system — finds real problems, explains what went wrong, and tells you exactly how to fix them.",
  "type": "module",
  "bin": {
    "linux-doctor": "bin/doctor.js"
  },
  "files": [
    "bin",
    "src",
    "src-gui/index.html",
    "README.md",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "CONTRIBUTING.md",
    "packaging",
    "docs/checks.md",
    "docs/cli.md",
    "docs/configuration.md",
    "docs/dashboard.md",
    "docs/integrations.md",
    "docs/output-parity.md",
    "docs/severity.md",
    "docs/licensing.md",
    "docs/trademark.md",
    "docs/RELEASING.md",
    "docs/screenshots/dashboard-dark.png",
    "docs/screenshots/dashboard-light.png"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js tests/golden/*.test.js",
    "goldens:update": "node scripts/update-goldens.mjs",
    "demo:gif": "node scripts/demo-gif.mjs",
    "demo:app": "bash scripts/demo-app-gif.sh",
    "build:gui": "node scripts/build-gui.mjs",
    "gui:dev": "node scripts/fetch-node-runtime.mjs && tauri dev",
    "gui:build": "node scripts/fetch-node-runtime.mjs && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7sh1d0w7x/linux-doctor.git"
  },
  "homepage": "https://github.com/7sh1d0w7x/linux-doctor#readme",
  "bugs": {
    "url": "https://github.com/7sh1d0w7x/linux-doctor/issues"
  },
  "author": "7sh1d0w7x",
  "keywords": [
    "linux",
    "diagnostics",
    "troubleshooting",
    "health-check",
    "system",
    "sysadmin",
    "devops",
    "cli",
    "monitoring",
    "observability",
    "systemd",
    "shell",
    "homelab",
    "self-hosted",
    "tauri",
    "linux-tools"
  ],
  "license": "GPL-3.0-or-later"
}
