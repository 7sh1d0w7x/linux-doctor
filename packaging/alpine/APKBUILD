# Maintainer: 7sh1d0w7x <zshadow7x@users.noreply.github.com>
# Alpine package for linux-doctor.
#
# Source: the npm tarball attached to the GitHub release. It extracts to a
# `package/` directory, hence builddir below. The tarball is the same artifact
# every other channel ships, so the package cannot drift from the release.
#
# The hash cannot be computed before the tag exists, so a version bump needs a
# second commit with the new sha512 (compute it with: curl -sLO <source> &&
# sha512sum linux-doctor-<ver>.tgz). Alpine does not accept SKIP here.
pkgname=linux-doctor
pkgver=0.9.0
pkgrel=0
pkgdesc="Read-only health checks for your Linux system"
url="https://github.com/7sh1d0w7x/linux-doctor"
arch="noarch"
license="GPL-3.0-or-later"
depends="nodejs"
makedepends=""
source="$pkgname-$pkgver.tgz::https://github.com/7sh1d0w7x/linux-doctor/releases/download/v$pkgver/$pkgname-$pkgver.tgz"
sha512sums="TODO-compute-after-tag  linux-doctor-0.9.0.tgz"
builddir="$srcdir/package"
options="!check"  # the suite needs npm dev dependencies; CI already runs it on Alpine

build() {
	# Nothing to compile: the tarball ships the JS the runtime executes.
	:
}

package() {
	install -d "$pkgdir/usr/lib/linux-doctor" "$pkgdir/usr/bin"
	cp -r "$builddir/bin" "$builddir/src" "$builddir/package.json" \
		"$builddir/README.md" "$builddir/LICENSE" "$pkgdir/usr/lib/linux-doctor/"
	install -Dm644 "$builddir/src-gui/index.html" \
		"$pkgdir/usr/lib/linux-doctor/src-gui/index.html"
	ln -s /usr/lib/linux-doctor/bin/doctor.js "$pkgdir/usr/bin/linux-doctor"
}
