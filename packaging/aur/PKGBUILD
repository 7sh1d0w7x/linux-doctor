# Maintainer: 7sh1d0w7x <zshadow7x@users.noreply.github.com>
# Arch Linux package for linux-doctor.
#
# Source: the GitHub release tag tarball (same tree as the npm tarball).
# It extracts to linux-doctor-$pkgver/ — the primary layout below; an npm
# `package/` layout (from `npm pack`) also works as a fallback in package().
#
# IMPORTANT: on every version bump, update sha256sums with the real sha256 of
# the new tarball (AUR rejects the source otherwise) and regenerate .SRCINFO:
#   curl -sLO https://github.com/7sh1d0w7x/linux-doctor/archive/refs/tags/v$pkgver.tar.gz
#   sha256sum v$pkgver.tar.gz
#   makepkg --printsrcinfo > .SRCINFO
pkgname=linux-doctor
pkgver=0.7.2
pkgrel=1
pkgdesc="Read-only health checks for your Linux system — finds real problems, explains them, and tells you how to fix them"
arch=('any')
url="https://github.com/7sh1d0w7x/linux-doctor"
license=('GPL-3.0-or-later')
depends=('nodejs>=20')
source=("$pkgname-$pkgver.tar.gz::https://github.com/7sh1d0w7x/linux-doctor/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  # GitHub tag tarballs extract to $srcdir/linux-doctor-$pkgver/; an npm
  # pack tarball extracts to $srcdir/package/ — both layouts are handled.
  local src="${srcdir}/${pkgname}-${pkgver}"
  [ -d "${src}" ] || src="${srcdir}/package"
  install -d "${pkgdir}/usr/lib/linux-doctor" "${pkgdir}/usr/lib/linux-doctor/src-gui" "${pkgdir}/usr/bin"
  cp -r "${src}/bin" "${src}/src" "${src}/package.json" "${src}/README.md" "${src}/LICENSE" "${pkgdir}/usr/lib/linux-doctor/"
  install -Dm644 "${src}/src-gui/index.html" "${pkgdir}/usr/lib/linux-doctor/src-gui/index.html"
  ln -s /usr/lib/linux-doctor/bin/doctor.js "${pkgdir}/usr/bin/linux-doctor"
  chmod 0755 "${pkgdir}/usr/lib/linux-doctor/bin/doctor.js"
}
